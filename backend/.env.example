# ---------------------------------------------------------------------------
# CodeSathi AI — backend environment
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# On Vercel, set these in Project → Settings → Environment Variables instead.
# ---------------------------------------------------------------------------

# === Database ==============================================================
# REQUIRED in production. Serverless functions keep nothing in memory, so
# users, sessions and indexed files all live here.
# Neon and Vercel Postgres both hand out a `postgresql://` URL; that is
# normalised to the pure-Python pg8000 driver automatically.
# Leave unset locally to use a SQLite file instead.
DATABASE_URL=

# === Accounts ==============================================================
# Optional Google sign-in. Without these the app still works and the API
# reports that Google is unavailable rather than failing obscurely.
# Authorised redirect URI: https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the redirect URI cannot be derived from the request.
GOOGLE_REDIRECT_URI=

SESSION_COOKIE_NAME=codesathi_session
SESSION_TTL_DAYS=30
# Cookies are marked Secure automatically when VERCEL=1. Override if you
# terminate TLS somewhere else.
# COOKIE_SECURE=true
MIN_PASSWORD_LENGTH=8
# Sign-in and sign-up are limited far below the general rate.
AUTH_RATE_LIMIT_PER_MINUTE=10

# === Sarvam ================================================================
# REQUIRED for AI explanations. Get a key from https://dashboard.sarvam.ai
# Without it the app still runs: you can browse repositories and inspect
# evidence, but questions cannot be answered.
SARVAM_API_KEY=sk_p2z7zxcr_vgDkEZWSMXhSS374nhPVtbDB

# Sarvam chat model. `sarvam-105b` is the flagship (128K context) model used
# for code reasoning. `sarvam-105b-conversations` is the 32K dialogue variant.
SARVAM_MODEL=sarvam-105b

# Reasoning is OFF by default here, even though the Sarvam API enables it.
# Measured against the live API: with reasoning at "low", a real code question
# consumed the whole token budget on internal reasoning and returned an empty
# answer. With reasoning off, the same question returned a complete structured
# answer in ~240 tokens.
# Leave blank for the fast, reliable default. To enable reasoning, set it to
# low/high/max AND raise SARVAM_MAX_TOKENS well above the reasoning budget.
SARVAM_REASONING_EFFORT=
SARVAM_MAX_TOKENS=4096

# Response format: json_object (default), json_schema, or text.
# json_object is the default because json_schema was measured to make the model
# pad its reply with newlines and run to the token cap without stopping.
SARVAM_RESPONSE_FORMAT=json_object
SARVAM_TEMPERATURE=0.2
SARVAM_TIMEOUT_SECONDS=90

# === Storage limits ========================================================
# Vercel caps a serverless request body at ~4.5 MB, so archives are unpacked
# in the browser and uploaded in batches. These bound what a project may hold.
MAX_STORED_BYTES=12582912
UPLOAD_BATCH_FILES=150
UPLOAD_BATCH_BYTES=3145728
MAX_ARCHIVE_FILES=1500
MAX_FILE_BYTES=1500000
MAX_INDEXED_FILE_BYTES=512000

# === Retrieval =============================================================
CONTEXT_CHAR_BUDGET=24000
MAX_SNIPPETS=8

# === Server ================================================================
# Comma-separated list of frontend origins allowed by CORS. In production the
# frontend and API share an origin, so this only matters in local development.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PORT=8000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30
PROJECT_TTL_SECONDS=21600
