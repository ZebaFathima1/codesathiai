# ---------------------------------------------------------------------------
# CodeSathi AI — frontend build-time environment
# Copy to `.env.local` for local work. On Vercel, set these in
# Project → Settings → Environment Variables and redeploy.
# ---------------------------------------------------------------------------

# Where the API lives.
#
# Leave UNSET when the API shares this origin: the Vite dev proxy in
# development, or a Vercel rewrite / Python function in production.
#
# Set it to the absolute URL when the backend is hosted elsewhere, e.g.
# Render. The browser then calls that origin directly, so the backend must
# list this site's URL in FRONTEND_ORIGINS and will issue its session cookie
# as SameSite=None; Secure.
#
# VITE_API_BASE_URL=https://codesathiai-backend.onrender.com/api
